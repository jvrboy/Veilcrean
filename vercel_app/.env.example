# Vercel environment variables for the Veilcrean API.
# Set these in Vercel Project → Settings → Environment Variables.

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Server-side only. Never expose this in client-side code.
SUPABASE_SERVICE_ROLE_KEY=

# Long random API key used by the Python brain / trusted clients.
# Generate with: openssl rand -hex 32
VEIL_API_KEY=

# Optional
SUPABASE_SCHEMA=public
VEIL_PUBLIC_READ=false
CORS_ORIGINS=*
DEBUG_ERRORS=false
SUPABASE_TIMEOUT_SECONDS=12
