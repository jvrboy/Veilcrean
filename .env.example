# Veilcrean — Environment Configuration
# Copy this file to .env and fill in your values.

# ZMQ endpoints (defaults are fine for a single-machine setup)
VEIL_ZMQ_PUB=tcp://127.0.0.1:5555
VEIL_ZMQ_PULL=tcp://127.0.0.1:5556
VEIL_ZMQ_STATUS=tcp://127.0.0.1:5557

# Telegram alerts (optional)
VEIL_TG_TOKEN=
VEIL_TG_CHAT=

# Discord alerts (optional)
VEIL_DISCORD_HOOK=

# Optional Vercel + Supabase bridge
# When set, the local/VPS Python brain posts status/trade events to the Vercel API,
# and the Vercel API writes them into Supabase.
VEIL_VERCEL_API_URL=https://your-vercel-project.vercel.app
VEIL_API_KEY=
# Poll Supabase command queue created by Telegram/Vercel. Set 0 to disable.
VEIL_COMMAND_POLL_SECONDS=10
# Must be true before Telegram /flatten can send FLATTEN_ALL to the EA.
VEIL_ENABLE_REMOTE_TRADE_COMMANDS=false
