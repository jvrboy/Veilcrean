# Cloudflare deployment secret reference for Veilcrean.
# Do NOT commit real values. Use `npx wrangler secret put NAME` instead.

# Required if VEIL_REQUIRE_API_KEY=true in wrangler.jsonc.
VEIL_STATUS_API_KEY=change-me-long-random-token

# Optional broker / model / alert secrets.
DERIV_API_TOKEN=
GROQ_API_KEY=
GEMINI_API_KEY=
VEIL_TG_TOKEN=
VEIL_TG_CHAT=
VEIL_DISCORD_HOOK=

# Non-secret runtime vars live in wrangler.jsonc:
# - DERIV_APP_ID
# - DERIV_ENABLED
# - DERIV_IS_DEMO
# - VEIL_LLM_PROVIDER
# - VEIL_LLM_ENABLED
# - VEIL_ZMQ_PUB / VEIL_ZMQ_PULL / VEIL_ZMQ_STATUS
